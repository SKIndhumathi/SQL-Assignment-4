CREATE DATABASE lib;
USE lib;
CREATE TABLE book (
    book_id INT PRIMARY KEY AUTO_INCREMENT,
    title VARCHAR(100) NOT NULL,
    author VARCHAR(50) NOT NULL,
    category VARCHAR(30),
    price DECIMAL(8,2),
    quantity INT,
    published_year INT
);
    
